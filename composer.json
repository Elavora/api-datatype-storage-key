{
  "name": "elavora/api-datatype-storage-key",
  "description": "DataType de chave de storage para aplicacoes Elavora API.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "elavora/api-datatype-file-path": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Elavora\\Api\\DataTypes\\Storage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Elavora\\Api\\DataTypes\\StorageKey\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "elavora/code-standards": "^1.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "lint": "elavora-standards lint",
    "test": "phpunit -c phpunit.xml",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ],
    "post-install-cmd": ["Elavora\\CodeStandards\\Composer::sync"],
    "post-update-cmd": ["Elavora\\CodeStandards\\Composer::sync"]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
